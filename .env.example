# ── UAI local development ────────────────────────────────────────────────────
# Copy to .env. Everything below the first block is read by code that exists;
# everything under "Not yet read by any code" is there to show the shape of the
# final configuration and is labelled with the phase that starts honouring it.
# (Project rule 8: never state in the present tense what does not exist yet.)

# ── Read today ───────────────────────────────────────────────────────────────
# services/gateway
PG_DSN=postgres://uai:uai@localhost:5432/uai?sslmode=disable
UAI_ADDR=:8080
# The external scheme is explicit: a server-side request has a relative URL, and
# rebuilding the wrong absolute target makes every PoP signature verify against a
# resource the caller never addressed. Use https anywhere real.
UAI_SCHEME=http

# deploy/compose/compose.yaml
POSTGRES_USER=uai
POSTGRES_PASSWORD=uai
POSTGRES_DB=uai
POSTGRES_PORT=5432

# test/ — set by `make integration`; a separate database so a failing test run
# can never leave your development data in an asserted-broken state.
# UAI_TEST_DSN=postgres://uai:uai@localhost:55433/uai?sslmode=disable

# ── Not yet read by any code ─────────────────────────────────────────────────
# Phase 6 — policy
# UAI_POLICY_BUNDLE=policy/gasc-2027.4
# UAI_POLICY_VERSION=GASC-2027.4

# Phase 7 — transparency log and consortium ledger
# UAI_LOG_ORIGIN=uai.world/log/1
# UAI_CHECKPOINT_INTERVAL_SECONDS=10
# UAI_WITNESS_MIN=2
# UAI_CHAIN_RPC=http://localhost:8545
# UAI_CHAIN_ID=13370
# UAI_PUBLIC_ANCHOR_ADAPTER=noop-dev

# Phase 9 — evidence vault object storage
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=uai-evidence

# Phase 11 — key management. Production uses an HSM/KMS; key material is never
# committed and never lands in a container image or build context.
# UAI_KMS_BACKEND=dev-file
# UAI_KMS_DEV_DIR=.keys

# Phase 12 — workload identity
# SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
# UAI_TRUST_DOMAIN=uai.world
