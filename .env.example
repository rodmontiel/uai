# ── UAI local development ────────────────────────────────────────────────────
# Copy to .env. Everything above "Not yet read by any code" is read by code that
# exists today; everything below is there to show the shape of the final
# configuration and is labelled with the phase that starts honouring it.
# (Project rule 8: never state in the present tense what does not exist yet.)

# ── Read today ───────────────────────────────────────────────────────────────
# services/gateway
PG_DSN=postgres://uai:uai@localhost:5432/uai?sslmode=disable
UAI_ADDR=:8080
# The external scheme is explicit: a server-side request has a relative URL, and
# rebuilding the wrong absolute target makes every PoP signature verify against a
# resource the caller never addressed. Use https anywhere real.
UAI_SCHEME=http
# The credential issuer. Created once with `make issuer-key` and never at boot:
# a key that changes on restart issues credentials that stop verifying, and the
# operator finds out from verification failures instead of a startup error.
UAI_ISSUER_DID=did:web:credentials.uai.world
UAI_ISSUER_KEY=.keys/issuer.jwk
# The signed policy bundle. The gateway refuses to start if it does not verify
# against the authority set: a PDP with no policy authorizes nothing, and saying
# so once at startup beats saying it once per request.
UAI_POLICY_BUNDLE=policy/gasc-2027.4
UAI_POLICY_AUTHORITY=policy/authority.json
# The transparency log this instance writes to.
UAI_LOG_ORIGIN=uai.world/log/1

# services/web — one origin for the pages and the API, so the CSP can forbid
# everything else (docs/adr/0003-a-frontend-with-no-dependencies.md).
UAI_WEB_ADDR=:8081
UAI_WEB_ROOT=web
UAI_API_URL=http://127.0.0.1:8080

# services/ledger-writer — anchoring checkpoints on the consortium chain.
# UAI_PUBLIC_ANCHOR_ADAPTER=noop-dev deliberately publishes NOTHING and returns
# an error rather than a plausible transaction hash (project rule 15).
UAI_CHAIN_RPC=http://localhost:8545
UAI_CHAIN_FROM=
UAI_ANCHOR_CONTRACT=
UAI_PUBLIC_ANCHOR_ADAPTER=noop-dev

# sdk/* and mcp/ — the agent side. These name ONE registered identity; there is
# no default id or key, because an SDK that invented one would sign as an
# identity nobody registered.
UAI_ENDPOINT=http://127.0.0.1:8080
UAI_AGENT_ID=
UAI_AGENT_KEY=.keys/agent.jwk
UAI_OWNER_DID=

# deploy/compose/compose.yaml
POSTGRES_USER=uai
POSTGRES_PASSWORD=uai
POSTGRES_DB=uai
POSTGRES_PORT=5432

# test/ — set by `make integration`; a separate database so a failing test run
# can never leave your development data in an asserted-broken state.
# UAI_TEST_DSN=postgres://uai:uai@localhost:55433/uai?sslmode=disable

# ── Not yet read by any code ─────────────────────────────────────────────────
# Phase 10 — evidence vault object storage
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=uai-evidence

# Phase 11 — key management. Production uses an HSM/KMS; key material is never
# committed and never lands in a container image or build context.
# UAI_KMS_BACKEND=dev-file
# UAI_KMS_DEV_DIR=.keys

# Phase 12 — workload identity
# SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
# UAI_TRUST_DOMAIN=uai.world
