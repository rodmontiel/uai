# ── UAI local development ────────────────────────────────────────────────────
UAI_ENV=development
UAI_LOG_LEVEL=debug

# PostgreSQL
POSTGRES_USER=uai
POSTGRES_PASSWORD=uai
POSTGRES_DB=uai
PG_DSN=postgres://uai:uai@localhost:5432/uai?sslmode=disable

# Redis (nonce replay cache, rate limits)
REDIS_ADDR=localhost:6379

# NATS JetStream
NATS_URL=nats://localhost:4222

# MinIO (evidence vault objects)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=uai-dev
MINIO_SECRET_KEY=uai-dev-secret
MINIO_BUCKET=uai-evidence

# Transparency log
UAI_LOG_ORIGIN=uai.world/log/1
UAI_CHECKPOINT_INTERVAL_SECONDS=10
UAI_WITNESS_MIN=2

# Consortium ledger (Besu QBFT, local)
UAI_CHAIN_RPC=http://localhost:8545
UAI_CHAIN_ID=13370
UAI_PUBLIC_ANCHOR_ADAPTER=noop-dev

# Policy
UAI_POLICY_BUNDLE=policy/gasc-2027.4
UAI_POLICY_VERSION=GASC-2027.4

# Key management — development only. Production uses HSM/KMS; never commit key material.
UAI_KMS_BACKEND=dev-file
UAI_KMS_DEV_DIR=.keys

# SPIFFE
SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
UAI_TRUST_DOMAIN=uai.world
