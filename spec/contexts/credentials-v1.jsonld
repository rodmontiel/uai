{
  "@context": {
    "@version": 1.1,
    "@protected": true,
    "uai": "https://uai.world/ns/credentials/v1#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "AgentIdentityCredential": {
      "@id": "uai:AgentIdentityCredential",
      "@context": {
        "@protected": true,
        "logicalName": "uai:logicalName",
        "version": "uai:version",
        "agentType": "uai:agentType",
        "vendor": "uai:vendor",
        "modelFamily": "uai:modelFamily",
        "modelPinned": { "@id": "uai:modelPinned", "@type": "xsd:boolean" },
        "framework": "uai:framework",
        "primaryJurisdiction": "uai:primaryJurisdiction",
        "assuranceLevel": "uai:assuranceLevel",
        "identityCommitment": "uai:identityCommitment"
      }
    },

    "AgentOwnershipCredential": {
      "@id": "uai:AgentOwnershipCredential",
      "@context": {
        "@protected": true,
        "ownerDid": { "@id": "uai:ownerDid", "@type": "@id" },
        "orgDid": { "@id": "uai:orgDid", "@type": "@id" },
        "effectiveFrom": { "@id": "uai:effectiveFrom", "@type": "xsd:dateTime" },
        "ownerProof": "uai:ownerProof",
        "agentProof": "uai:agentProof"
      }
    },

    "AgentCapabilityCredential": {
      "@id": "uai:AgentCapabilityCredential",
      "@context": {
        "@protected": true,
        "capabilities": { "@id": "uai:capabilities", "@container": "@set" },
        "constraints": "uai:constraints",
        "riskClass": "uai:riskClass",
        "minAssurance": "uai:minAssurance"
      }
    },

    "OrganizationCredential": {
      "@id": "uai:OrganizationCredential",
      "@context": {
        "@protected": true,
        "legalName": "uai:legalName",
        "jurisdiction": "uai:jurisdiction",
        "registrationRef": "uai:registrationRef"
      }
    },

    "AgentSafetyAttestation": {
      "@id": "uai:AgentSafetyAttestation",
      "@context": {
        "@protected": true,
        "evaluations": { "@id": "uai:evaluations", "@container": "@set" },
        "guardrailConfigHash": "uai:guardrailConfigHash",
        "evaluatorDid": { "@id": "uai:evaluatorDid", "@type": "@id" },
        "scope": "uai:scope"
      }
    },

    "AgentRevocationCredential": {
      "@id": "uai:AgentRevocationCredential",
      "@context": {
        "@protected": true,
        "caseId": "uai:caseId",
        "decisionId": "uai:decisionId",
        "governanceProofHash": "uai:governanceProofHash",
        "effectiveAt": { "@id": "uai:effectiveAt", "@type": "xsd:dateTime" }
      }
    }
  }
}
