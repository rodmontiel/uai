{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uai.world/schemas/v0.1/agent-ownership-credential.schema.json",
  "title": "UAI Agent Ownership Credential",
  "description": "A W3C Verifiable Credential recording WHO ANSWERS for an agent. It embeds the two-sided registration proof verbatim, which is what lets a relying party validate ownership from this document plus the owner's public key alone. The issuer's own signature attests only that the exchange was witnessed and an identifier was minted; the ownership claim itself does not rest on trusting the issuer.",
  "type": "object",
  "required": [
    "@context",
    "type",
    "id",
    "issuer",
    "validFrom",
    "credentialSubject",
    "proof"
  ],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "const": "https://www.w3.org/ns/credentials/v2"
        },
        {
          "const": "https://uai.world/ns/credentials/v1"
        }
      ]
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "const": "VerifiableCredential"
        },
        {
          "const": "AgentOwnershipCredential"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^urn:uai:credential:[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "issuer": {
      "$ref": "common.schema.json#/$defs/did"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "not": {},
      "description": "Forbidden. Ownership holds until the agent is unbound, which is an event, not a date. An expiry here would mean an agent silently loses the party that answers for it on a day nobody chose."
    },
    "credentialStatus": {
      "$ref": "agent-identity-credential.schema.json#/$defs/status"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "ownerDid",
        "effectiveFrom",
        "bindingProof"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uaiDid"
        },
        "ownerDid": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "orgDid": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date-time"
        },
        "bindingProof": {
          "$ref": "#/$defs/bindingProof"
        }
      }
    },
    "proof": {
      "$ref": "agent-identity-credential.schema.json#/$defs/proof"
    }
  },
  "$defs": {
    "bindingProof": {
      "type": "object",
      "description": "The registration exchange, kept whole. Both halves name the same agentKeyThumbprint and the same owner; two signatures over different subjects are two unrelated statements, not a proof of ownership.",
      "required": [
        "registrationId",
        "agentKeyThumbprint",
        "agentPublicKeyJwk",
        "ownerProof",
        "agentProof"
      ],
      "properties": {
        "registrationId": {
          "type": "string",
          "pattern": "^reg_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "agentKeyThumbprint": {
          "$ref": "common.schema.json#/$defs/sha256Digest"
        },
        "agentPublicKeyJwk": {
          "type": "object",
          "required": [
            "kty"
          ],
          "description": "The agent's public key travels inside the proof, so a verifier never has to ask UAI whether the agent exists.",
          "properties": {
            "kty": {
              "enum": [
                "OKP",
                "EC"
              ]
            },
            "crv": {
              "enum": [
                "Ed25519",
                "P-256",
                "P-384"
              ]
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            }
          }
        },
        "ownerKeyId": {
          "$ref": "common.schema.json#/$defs/didUrl"
        },
        "ownerProof": {
          "$ref": "#/$defs/proofHalf"
        },
        "agentProof": {
          "$ref": "#/$defs/proofHalf"
        }
      }
    },
    "proofHalf": {
      "type": "object",
      "required": [
        "challenge",
        "signature"
      ],
      "properties": {
        "challenge": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/signature"
            }
          ],
          "properties": {
            "domain": {
              "const": "UAI-v1:challenge",
              "description": "Each half is a challenge response. A signature made in any other domain must not count as one, or a proof produced for an unrelated purpose could be pasted in here."
            }
          }
        }
      }
    }
  }
}
