{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uai.world/schemas/v0.1/agent-passport-credential.schema.json",
  "title": "UAI Agent Passport Credential",
  "description": "A W3C Verifiable Credential authorizing an agent to act across jurisdictions. It is separate from the identity credential because jurisdictional authorization is time-bounded, scoped and revocable INDEPENDENTLY of identity: suspending a passport must not invalidate the identity or its history.",
  "type": "object",
  "required": ["@context", "type", "id", "issuer", "validFrom", "validUntil", "credentialSubject", "proof"],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "const": "https://www.w3.org/ns/credentials/v2" },
        { "const": "https://uai.world/ns/passport/v1" }
      ]
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [{ "const": "VerifiableCredential" }, { "const": "AgentPassportCredential" }]
    },
    "id": { "type": "string", "pattern": "^urn:uai:passport:[0-9A-HJKMNP-TV-Z]{26}$" },
    "issuer": { "$ref": "common.schema.json#/$defs/did" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": {
      "type": "string", "format": "date-time",
      "description": "Mandatory. A passport without an expiry is a standing authorization nobody reviews."
    },
    "credentialStatus": {
      "type": "object",
      "required": ["type", "statusPurpose", "statusListIndex", "statusListCredential"],
      "properties": {
        "type": { "const": "BitstringStatusListEntry" },
        "statusPurpose": { "enum": ["revocation", "suspension"] },
        "statusListIndex": { "type": "string" },
        "statusListCredential": { "type": "string", "format": "uri" }
      },
      "description": "Status lists let a relying party check revocation offline, without phoning home for every verification."
    },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "owner", "allowedJurisdictions", "authorizedCapabilities", "assuranceLevel", "policyVersion", "policyBundleHash", "state"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uaiDid" },
        "owner": { "$ref": "common.schema.json#/$defs/did" },
        "allowedJurisdictions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/isoCountry" } },
        "restrictedJurisdictions": {
          "type": "array", "items": { "$ref": "common.schema.json#/$defs/isoCountry" },
          "description": "Explicit rather than implied by omission: 'not listed as allowed' and 'explicitly restricted' are different facts, and an auditor cares about the second."
        },
        "authorizedCapabilities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["capability", "minAssurance"],
            "properties": {
              "capability": { "type": "string", "minLength": 1 },
              "minAssurance": { "$ref": "common.schema.json#/$defs/assuranceLevel" },
              "constraints": { "type": "object" }
            }
          }
        },
        "assuranceLevel": { "$ref": "common.schema.json#/$defs/assuranceLevel" },
        "policyVersion": { "type": "string", "minLength": 1 },
        "policyBundleHash": { "$ref": "common.schema.json#/$defs/sha256Digest" },
        "state": { "enum": ["VALID", "EXPIRED", "SUSPENDED", "QUARANTINED", "REVOKED"] }
      }
    },
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "enum": ["eddsa-jcs-2022", "ecdsa-jcs-2019"] },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "$ref": "common.schema.json#/$defs/didUrl" },
        "proofPurpose": { "const": "assertionMethod" },
        "domain": { "const": "UAI-v1:credential" },
        "proofValue": { "type": "string", "minLength": 1 }
      }
    }
  }
}
