{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uai.world/schemas/v0.1/agent-identity-credential.schema.json",
  "title": "UAI Agent Identity Credential",
  "description": "A W3C Verifiable Credential stating what an agent IS. It deliberately says nothing about whether the agent is safe or competent: assuranceLevel records how strongly the IDENTITY was established, not how well the agent behaves. Conflating the two is the failure mode P1 exists to prevent.",
  "type": "object",
  "required": ["@context", "type", "id", "issuer", "validFrom", "validUntil", "credentialSubject", "proof"],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "const": "https://www.w3.org/ns/credentials/v2" },
        { "const": "https://uai.world/ns/credentials/v1" }
      ]
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "const": "VerifiableCredential" },
        { "const": "AgentIdentityCredential" }
      ]
    },
    "id": { "type": "string", "pattern": "^urn:uai:credential:[0-9A-HJKMNP-TV-Z]{26}$" },
    "issuer": { "$ref": "common.schema.json#/$defs/did" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "Required. An identity credential that never expires is one a verifier is never forced to re-check, and a document nobody re-checks stops reflecting reality the moment it is issued."
    },
    "credentialStatus": { "$ref": "#/$defs/status" },
    "credentialSubject": {
      "type": "object",
      "required": ["id", "name", "agentType", "primaryJurisdiction", "assuranceLevel", "agentKeyThumbprint"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uaiDid" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "agentType": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string" },
        "modelFamily": { "type": "string" },
        "modelPinned": {
          "type": "boolean",
          "description": "false means the identity survives a model swap. Pinning is for agents whose assurance argument depends on a specific model version."
        },
        "framework": { "type": "string" },
        "primaryJurisdiction": { "$ref": "common.schema.json#/$defs/isoCountry" },
        "assuranceLevel": { "$ref": "common.schema.json#/$defs/assuranceLevel" },
        "agentKeyThumbprint": {
          "$ref": "common.schema.json#/$defs/sha256Digest",
          "description": "RFC 7638 thumbprint of the key the agent proved control of at registration. Required: a credential that names an agent but not its key cannot be tied to anything the agent signs."
        }
      }
    },
    "proof": { "$ref": "#/$defs/proof" }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "required": ["type", "cryptosuite", "created", "verificationMethod", "proofPurpose", "domain", "proofValue"],
      "properties": {
        "type": { "const": "DataIntegrityProof" },
        "cryptosuite": { "enum": ["eddsa-jcs-2022", "ecdsa-jcs-2019"] },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "$ref": "common.schema.json#/$defs/didUrl" },
        "proofPurpose": { "const": "assertionMethod" },
        "domain": {
          "const": "UAI-v1:credential",
          "description": "Domain separation is part of the signed proof options, so a signature made for another purpose cannot be presented here even if the bytes line up."
        },
        "proofValue": {
          "type": "string",
          "pattern": "^[zu][A-Za-z0-9_-]+$",
          "description": "Multibase. UAI emits base58btc ('z'); base64url ('u') is accepted on verification because it is equally valid multibase."
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["type", "statusPurpose", "statusListIndex", "statusListCredential"],
      "properties": {
        "type": { "const": "BitstringStatusListEntry" },
        "statusPurpose": { "enum": ["revocation", "suspension"] },
        "statusListIndex": { "type": "string" },
        "statusListCredential": { "type": "string", "format": "uri" }
      }
    }
  }
}
